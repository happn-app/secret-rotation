{
  "cronjob": {
    "prefix": ["handler"],
    "body": [
      "package ${1:name}",
      "",
      "import (",
      "\t\"context\"",
      "\t\"fmt\"",
      "\t\"log/slog\"",
      "\t\"os\"",
      "",
      "\tsecretmanager \"cloud.google.com/go/secretmanager/apiv1\"",
      "\t\"cloud.google.com/go/secretmanager/apiv1/secretmanagerpb\"",
      "\t\"happn.io/secret-rotation/pkg/config\"",
      "\t\"happn.io/secret-rotation/pkg/types\"",
      ")",
      "",
      "type ${2:Name}Handler struct {",
      "\tctx context.Context",
      "\tclient *secretmanager.Client",
      "\tsecret *secretmanagerpb.Secret",
      "\tprojectId string",
      "\tlogger *slog.Logger",
      "}",
      "",
      "func New(ctx context.Context, client *secretmanager.Client, secret *secretmanagerpb.Secret, cfg config.Config) ${2:Name}Handler {",
      "\treturn ${2:Name}Handler{",
      "\t\tctx:   ctx,",
      "\t\tclient: client,",
      "\t\tsecret: secret,",
      "\t\tprojectId: cfg.GcpProjectId,",
      "\t\tlogger: slog.New(slog.NewJSONHandler(",
      "\t\t\tos.Stdout, &slog.HandlerOptions{Level: cfg.LogLevel},",
      "\t\t)).With(",
      "\t\t\t\"component\", \"secret_handler\",",
      "\t\t\t\"handler\", \"${1:name}\",",
      "\t\t),",
      "\t}",
      "}",
      "",
      "func (handler ${2:Name}Handler) Name() string {",
      "\treturn \"${1:name}\"",
      "}",
      "",
      "func (handler ${2:Name}Handler) Handle(msg types.PubSubMessage) error {",
      "\t// Implement your handler logic here",
      "\treturn fmt.Errorf(\"${2:Name}Handler.Handle not implemented yet\")",
      "}",
      ""
    ],
    "description": "Handler Go scaffolding",
    "include": ["**/*.go"]
  }
}
